{
  "appId": "com.darussalam.kitabcloud",
  "appName": "Kitab Cloud",
  "webDir": "build",
  "bundledWebRuntime": false,
  "server": {
    "hostname": "kitab-cloud.preview.emergentagent.com",
    "androidScheme": "https",
    "iosScheme": "https",
    "allowNavigation": ["checkout.stripe.com", "*.stripe.com"]
  },
  "ios": {
    "contentInset": "automatic",
    "allowsLinkPreview": false,
    "scrollEnabled": true,
    "backgroundColor": "#02120F",
    "appendUserAgent": "KitabCloudApp"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#02120F",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#02120F"
    },
    "CapacitorHttp": {
      "enabled": true
    }
  }
}
