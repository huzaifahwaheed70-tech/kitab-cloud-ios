{
  "appId": "com.darussalam.kitabcloud",
  "appName": "Kitab Cloud",
  "webDir": "build",
  "server": {
    "androidScheme": "https",
    "iosScheme": "https",
    "allowNavigation": ["*"]
  },
  "ios": {
    "contentInset": "automatic",
    "allowsLinkPreview": false,
    "scrollEnabled": true,
    "backgroundColor": "#02120F",
    "limitsNavigationsToAppBoundDomains": false,
    "preferredContentMode": "mobile"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#02120F",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#02120F"
    }
  }
}
