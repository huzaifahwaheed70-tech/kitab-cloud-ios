{
  "appId": "host.emergent.kitabcloud",
  "appName": "Kitab Cloud",
  "webDir": "build",
  "bundledWebRuntime": false,
  "server": {
    "allowNavigation": [
      "kitab-cloud.emergent.host"
    ]
  },
  "ios": {
    "contentInset": "automatic",
    "allowsLinkPreview": true,
    "scrollEnabled": true,
    "backgroundColor": "#02120F"
  },
  "android": {
    "backgroundColor": "#02120F",
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#02120F",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#02120F"
    }
  }
}
