{
  "appId": "host.emergent.kitabcloud",
  "appName": "Kitab Cloud",
  "webDir": "build",
  "server": {
    "url": "https://kitab-cloud.emergent.host",
    "cleartext": true,
    "allowNavigation": ["*"]
  },
  "ios": {
    "contentInset": "automatic",
    "allowsLinkPreview": true,
    "scrollEnabled": true,
    "backgroundColor": "#02120F",
    "allowNavigation": ["*"]
  },
  "android": {
    "backgroundColor": "#02120F",
    "allowMixedContent": true,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "android": {
    "backgroundColor": "#02120F"
  },
  "plugins": {
    "SplashScreen": {
      "launchShowDuration": 2000,
      "backgroundColor": "#02120F",
      "showSpinner": false
    },
    "StatusBar": {
      "style": "DARK",
      "backgroundColor": "#02120F"
    },
    "OneSignal": {
      "appId": "31bf8b91-fdf9-427b-8908-9e52914d6d11"
    }
  }
}